module GtkAst
  class Node
    KEYS = %i[type children].freeze
    FIELDS = [].freeze
    PROPERTIES = {}.freeze

    attr_reader :children

    def initialize(children: [], **values)
      @children = children

      values.each do |field, value|
        raise ArgumentError, "#{self.class}: unknown field #{field.inspect}" unless self.class::KEYS.include?(field)

        instance_variable_set(:"@#{field}", value)
      end
    end

    def type = self.class::TYPE
    def gtype = self.class::GTYPE
    def fields = self.class::FIELDS
    def properties = self.class::PROPERTIES
    def keys = self.class::KEYS

    alias deconstruct children

    def deconstruct_keys(requested)
      (requested || [:type, :children, *keys]).each_with_object({}) do |key, deconstructed|
        case key
        when :type then deconstructed[:type] = type
        when :children then deconstructed[:children] = children
        else deconstructed[key] = public_send(key) if keys.include?(key)
        end
      end
    end

    def to_h
      keys.to_h { |key| [key, public_send(key)] }
    end

    def inspect
      shown = keys.filter_map do |field|
        value = public_send(field)
        [field, value.inspect].join(": ") unless value.nil?
      end
      [self.class.name.split("::").last, "(", shown.join(", "), ")"].join
    end
  end
<%- namespaces.keys.sort.each do |namespace| -%>
  module <%= namespace %>; end
<%- end -%>
<%- all_nodes.each do |node| -%>

  module <%= node.namespace %>
    <%= node.declaration %>
<%- node.includes.each do |included| -%>
      include <%= included %>
<%- end -%>

      TYPE = <%= node.type.inspect %>
      GTYPE = <%= node.gtype.inspect %>
<%- unless node.prerequisites.empty? -%>
      PREREQUISITES = <%= node.prerequisites.inspect %>.freeze
<%- end -%>
      FIELDS = <%= node.readers.inspect %>.freeze
      PROPERTIES = <%= node.property_map.inspect %>.freeze
      KEYS = <%= node.keys_expression %>.freeze
<%- node.domains.each do |field| -%>
      <%= field.constant_name %> = <%= field.domain.map(&:to_sym).inspect %>.freeze
<%- end -%>
<%- unless node.readers.empty? -%>

      attr_reader <%= node.readers.map(&:inspect).join(", ") %>
<%- end -%>
    end
  end
<%- end -%>

  BY_TYPE = {
<%- all_nodes.each do |node| -%>
    <%= node.type.inspect %> => <%= node.qualified %>,
<%- end -%>
  }.freeze

  BY_GTYPE = {
<%- all_nodes.select(&:gtype).each do |node| -%>
    <%= node.gtype.inspect %> => <%= node.qualified %>,
<%- end -%>
  }.freeze
end
