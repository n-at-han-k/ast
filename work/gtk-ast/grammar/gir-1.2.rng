<?xml version="1.0" encoding="UTF-8"?>
<grammar xmlns="http://relaxng.org/ns/structure/1.0"
         ns="http://www.gtk.org/introspection/core/1.0"
         xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0"
         xmlns:c="http://www.gtk.org/introspection/c/1.0"
         xmlns:core="http://www.gtk.org/introspection/core/1.0"
         xmlns:doc="http://www.gtk.org/introspection/doc/1.0"
         xmlns:glib="http://www.gtk.org/introspection/glib/1.0"
         xmlns:xml="http://www.w3.org/XML/1998/namespace"
         datatypeLibrary="http://www.w3.org/2001/XMLSchema-datatypes">
  <start>
    <ref name="Repository"/>
  </start>
  <define name="Repository">
    <element>
      <name ns="http://www.gtk.org/introspection/core/1.0">repository</name>
      <optional>
        <attribute>
          <a:documentation>version number of the repository</a:documentation>
          <name ns="">version</name>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute>
          <a:documentation>prefixes to filter out from C identifiers for data structures and types. For example, GtkWindow will be Window. If c:symbol-prefixes is not used, then this element is used for both</a:documentation>
          <name ns="http://www.gtk.org/introspection/c/1.0">identifier-prefixes</name>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute>
          <a:documentation>prefixes to filter out from C functions. For example, gtk_window_new will lose gtk_</a:documentation>
          <name ns="http://www.gtk.org/introspection/c/1.0">symbol-prefixes</name>
          <data type="string"/>
        </attribute>
      </optional>
      <interleave>
        <zeroOrMore>
          <ref name="Include"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="CInclude"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="Package"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="Namespace"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="DocFormat"/>
        </zeroOrMore>
      </interleave>
    </element>
  </define>
  <define name="Namespace">
    <element>
      <name ns="http://www.gtk.org/introspection/core/1.0">namespace</name>
      <optional>
        <attribute>
          <a:documentation>name of the namespace. For example, &#x27;Gtk&#x27;</a:documentation>
          <name ns="">name</name>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute>
          <a:documentation>version number of the namespace</a:documentation>
          <name ns="">version</name>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute>
          <a:documentation>prefixes to filter out from C identifiers for data structures and types. For example, GtkWindow will be Window. If c:symbol-prefixes is not used, then this element is used for both</a:documentation>
          <name ns="http://www.gtk.org/introspection/c/1.0">identifier-prefixes</name>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute>
          <a:documentation>prefixes to filter out from C functions. For example, gtk_window_new will lose gtk_</a:documentation>
          <name ns="http://www.gtk.org/introspection/c/1.0">symbol-prefixes</name>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute>
          <a:documentation>Deprecated: the same as c:identifier-prefixes. Only used for backward compatibility </a:documentation>
          <name ns="http://www.gtk.org/introspection/c/1.0">prefix</name>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute>
          <a:documentation>Path to the shared library implementing the namespace. It can be a comma-separated list, with relative path only</a:documentation>
          <name ns="">shared-library</name>
          <data type="string"/>
        </attribute>
      </optional>
      <interleave>
        <zeroOrMore>
          <ref name="Alias"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="Class"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="Interface"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="Record"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="Enum"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="Function"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="FunctionInline"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="FunctionMacro"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="Union"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="BitField"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="Callback"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="Constant"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="Annotation"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="Boxed"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="DocSection"/>
        </zeroOrMore>
      </interleave>
    </element>
  </define>
  <define name="Annotation">
    <element>
      <name ns="http://www.gtk.org/introspection/core/1.0">attribute</name>
      <attribute>
        <a:documentation>name of the attribute</a:documentation>
        <name ns="">name</name>
        <data type="string"/>
      </attribute>
      <attribute>
        <a:documentation>value of the attribute</a:documentation>
        <name ns="">value</name>
        <data type="string"/>
      </attribute>
    </element>
  </define>
  <define name="CInclude">
    <element>
      <name ns="http://www.gtk.org/introspection/c/1.0">include</name>
      <attribute>
        <a:documentation>File name of the C header file. The path can be relative.</a:documentation>
        <name ns="">name</name>
        <data type="string"/>
      </attribute>
      <empty/>
    </element>
  </define>
  <define name="DocFormat">
    <element>
      <a:documentation>Format used for the included documentation.</a:documentation>
      <name ns="http://www.gtk.org/introspection/doc/1.0">format</name>
      <attribute>
        <a:documentation>Name of the documentation format. Valid values are: gi-docgen, gtk-doc-docbook, gtk-doc-markdown, hotdoc, unknown.</a:documentation>
        <name ns="">name</name>
        <data type="string"/>
      </attribute>
      <empty/>
    </element>
  </define>
  <define name="Include">
    <element>
      <name ns="http://www.gtk.org/introspection/core/1.0">include</name>
      <attribute>
        <a:documentation>name of the dependant namespace to include</a:documentation>
        <name ns="">name</name>
        <data type="string"/>
      </attribute>
      <optional>
        <attribute>
          <a:documentation>version of the dependant namespace to use</a:documentation>
          <name ns="">version</name>
          <data type="string"/>
        </attribute>
      </optional>
      <empty/>
    </element>
  </define>
  <define name="Package">
    <element>
      <name ns="http://www.gtk.org/introspection/core/1.0">package</name>
      <attribute>
        <a:documentation>name of the pkg-config file, minus the extension</a:documentation>
        <name ns="">name</name>
        <data type="string"/>
      </attribute>
      <empty/>
    </element>
  </define>
  <define name="Alias">
    <element>
      <name ns="http://www.gtk.org/introspection/core/1.0">alias</name>
      <ref name="Info.attrs"/>
      <attribute>
        <a:documentation>the new name or typedef&#x27;d name</a:documentation>
        <name ns="">name</name>
        <data type="string"/>
      </attribute>
      <attribute>
        <a:documentation>the corresponding C type&#x27;s name</a:documentation>
        <name ns="http://www.gtk.org/introspection/c/1.0">type</name>
        <data type="string"/>
      </attribute>
      <interleave>
        <ref name="Info.elements"/>
        <optional>
          <ref name="AnyType"/>
        </optional>
      </interleave>
    </element>
  </define>
  <define name="Interface">
    <element>
      <name ns="http://www.gtk.org/introspection/core/1.0">interface</name>
      <ref name="Info.attrs"/>
      <attribute>
        <a:documentation>name of the interface</a:documentation>
        <name ns="">name</name>
        <data type="string"/>
      </attribute>
      <attribute>
        <a:documentation>Type name compatible with the GObject type system</a:documentation>
        <name ns="http://www.gtk.org/introspection/glib/1.0">type-name</name>
        <data type="string"/>
      </attribute>
      <attribute>
        <a:documentation>Function to get the GObject compatible type of the interface </a:documentation>
        <name ns="http://www.gtk.org/introspection/glib/1.0">get-type</name>
        <data type="string"/>
      </attribute>
      <optional>
        <attribute>
          <a:documentation>prefix to filter out from C functions. For example, gtk_window_new will lose gtk_</a:documentation>
          <name ns="http://www.gtk.org/introspection/c/1.0">symbol-prefix</name>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute>
          <a:documentation>Corresponding C type</a:documentation>
          <name ns="http://www.gtk.org/introspection/c/1.0">type</name>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute>
          <a:documentation>GObject compatible C structure defining the Interface</a:documentation>
          <name ns="http://www.gtk.org/introspection/glib/1.0">type-struct</name>
          <data type="string"/>
        </attribute>
      </optional>
      <interleave>
        <ref name="Info.elements"/>
        <zeroOrMore>
          <ref name="Prerequisite"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="Implements"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="Function"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="FunctionInline"/>
        </zeroOrMore>
        <optional>
          <ref name="Constructor"/>
        </optional>
        <zeroOrMore>
          <ref name="Method"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="MethodInline"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="VirtualMethod"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="Field"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="Property"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="Signal"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="Callback"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="Constant"/>
        </zeroOrMore>
      </interleave>
    </element>
  </define>
  <define name="Class">
    <element>
      <name ns="http://www.gtk.org/introspection/core/1.0">class</name>
      <ref name="Info.attrs"/>
      <attribute>
        <a:documentation>Name of the class</a:documentation>
        <name ns="">name</name>
        <data type="string"/>
      </attribute>
      <attribute>
        <a:documentation>GObject compatible type name of the class</a:documentation>
        <name ns="http://www.gtk.org/introspection/glib/1.0">type-name</name>
        <data type="string"/>
      </attribute>
      <attribute>
        <a:documentation>Function to get the GObject compatible type of the class</a:documentation>
        <name ns="http://www.gtk.org/introspection/glib/1.0">get-type</name>
        <data type="string"/>
      </attribute>
      <optional>
        <attribute>
          <a:documentation>Name of the parent class if any</a:documentation>
          <name ns="">parent</name>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute>
          <a:documentation>GObject compatible C structure defining the class</a:documentation>
          <name ns="http://www.gtk.org/introspection/glib/1.0">type-struct</name>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute>
          <a:documentation>GObject compatible function to reference or increase the reference count of the class</a:documentation>
          <name ns="http://www.gtk.org/introspection/glib/1.0">ref-func</name>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute>
          <a:documentation>GObject compatible function to unreference or decrease the reference count of the class</a:documentation>
          <name ns="http://www.gtk.org/introspection/glib/1.0">unref-func</name>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute>
          <a:documentation>GObject compatible function to set a value of a property of the class</a:documentation>
          <name ns="http://www.gtk.org/introspection/glib/1.0">set-value-func</name>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute>
          <a:documentation>GObject compatible function to get a value of a property of the class</a:documentation>
          <name ns="http://www.gtk.org/introspection/glib/1.0">get-value-func</name>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute>
          <a:documentation>C type of the class</a:documentation>
          <name ns="http://www.gtk.org/introspection/c/1.0">type</name>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute>
          <a:documentation>prefix to filter out from C functions. For example, gtk_window_new will lose gtk_</a:documentation>
          <name ns="http://www.gtk.org/introspection/c/1.0">symbol-prefix</name>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute>
          <a:documentation>Binary attribute to declare the class abstract or not</a:documentation>
          <name ns="">abstract</name>
          <choice>
            <value>0</value>
            <value>1</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute>
          <a:documentation>Binary attribute to declare the class fundamental or not (top-level class which do not derives from any other type)</a:documentation>
          <name ns="http://www.gtk.org/introspection/glib/1.0">fundamental</name>
          <choice>
            <value>0</value>
            <value>1</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute>
          <a:documentation>Binary attribute to declare the class final or not (non-derivable class in a derivable hierarchy)</a:documentation>
          <name ns="">final</name>
          <choice>
            <value>0</value>
            <value>1</value>
          </choice>
        </attribute>
      </optional>
      <interleave>
        <ref name="Info.elements"/>
        <zeroOrMore>
          <ref name="Implements"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="Constructor"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="Method"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="MethodInline"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="Function"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="FunctionInline"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="VirtualMethod"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="Field"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="Property"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="Signal"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="Union"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="Constant"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="Record"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="Callback"/>
        </zeroOrMore>
      </interleave>
    </element>
  </define>
  <define name="Boxed">
    <element>
      <name ns="http://www.gtk.org/introspection/glib/1.0">boxed</name>
      <ref name="Info.attrs"/>
      <attribute>
        <a:documentation>GObject compatible type name of the boxed type</a:documentation>
        <name ns="http://www.gtk.org/introspection/glib/1.0">name</name>
        <data type="string"/>
      </attribute>
      <optional>
        <attribute>
          <a:documentation>prefix to filter out from C functions. For example, gtk_window_new will lose gtk_</a:documentation>
          <name ns="http://www.gtk.org/introspection/c/1.0">symbol-prefix</name>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute>
          <a:documentation>GObject compatible type name of the boxed type</a:documentation>
          <name ns="http://www.gtk.org/introspection/glib/1.0">type-name</name>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute>
          <a:documentation>Function to get the GObject compatible type of the boxed type</a:documentation>
          <name ns="http://www.gtk.org/introspection/glib/1.0">get-type</name>
          <data type="string"/>
        </attribute>
      </optional>
      <interleave>
        <ref name="Info.elements"/>
        <zeroOrMore>
          <ref name="Function"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="FunctionInline"/>
        </zeroOrMore>
      </interleave>
    </element>
  </define>
  <define name="Record">
    <element>
      <name ns="http://www.gtk.org/introspection/core/1.0">record</name>
      <ref name="Info.attrs"/>
      <attribute>
        <a:documentation>name of the record</a:documentation>
        <name ns="">name</name>
        <data type="string"/>
      </attribute>
      <optional>
        <attribute>
          <a:documentation>Corresponding C type of the record</a:documentation>
          <name ns="http://www.gtk.org/introspection/c/1.0">type</name>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute>
          <a:documentation>Deprecated. Binary attribute to tell if the record is disguised, i.e. whether the c:type
is a typedef that doesn&#x27;t look like a pointer, but is one internally. Its second meaning
is &quot;private&quot; and is set when any typedef struct is parsed which doesn&#x27;t also include a
full struct with fields (https://gitlab.gnome.org/GNOME/gobject-introspection/issues/101)
Replaced by &quot;opaque&quot; and &quot;pointer&quot;.</a:documentation>
          <name ns="">disguised</name>
          <choice>
            <value>0</value>
            <value>1</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute>
          <a:documentation>Binary attribute for a typedef struct that does not have a corresponding public structure definition</a:documentation>
          <name ns="">opaque</name>
          <choice>
            <value>0</value>
            <value>1</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute>
          <a:documentation>Binary attribute for a typedef struct pointer, e.g. typedef struct Foo* FooPtr</a:documentation>
          <name ns="">pointer</name>
          <choice>
            <value>0</value>
            <value>1</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute>
          <a:documentation>GObject compatible C type of the record</a:documentation>
          <name ns="http://www.gtk.org/introspection/glib/1.0">type-name</name>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute>
          <a:documentation>Function to get the GObject compatible type of the record</a:documentation>
          <name ns="http://www.gtk.org/introspection/glib/1.0">get-type</name>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute>
          <a:documentation>prefix to filter out from C functions. For example, gtk_window_new will lose gtk_</a:documentation>
          <name ns="http://www.gtk.org/introspection/c/1.0">symbol-prefix</name>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute>
          <a:documentation>Binary attribute to tell if the record is foreign, that is it is not available in a g-i supported library</a:documentation>
          <name ns="">foreign</name>
          <choice>
            <value>0</value>
            <value>1</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute>
          <a:documentation>Name of the GObject compatible gtype this record represents. If empty, this record will be hidden from generated public APIs.</a:documentation>
          <name ns="http://www.gtk.org/introspection/glib/1.0">is-gtype-struct-for</name>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute>
          <a:documentation>Name of the function used to copy the record</a:documentation>
          <name ns="">copy-function</name>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute>
          <a:documentation>Name of the function used to free the record</a:documentation>
          <name ns="">free-function</name>
          <data type="string"/>
        </attribute>
      </optional>
      <interleave>
        <ref name="Info.elements"/>
        <zeroOrMore>
          <ref name="Field"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="Function"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="FunctionInline"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="Union"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="Method"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="MethodInline"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="Constructor"/>
        </zeroOrMore>
      </interleave>
    </element>
  </define>
  <define name="Info.attrs">
    <group>
      <optional>
        <attribute>
          <a:documentation>Binary attribute which is &quot;0&quot; (false) if the element is not introspectable. It doesn&#x27;t exist in the bindings, due in general to missing information in the annotations in the original C code</a:documentation>
          <name ns="">introspectable</name>
          <choice>
            <value>0</value>
            <value>1</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute>
          <a:documentation>Binary attribute which is &quot;1&quot; (true) if the element has been deprecated</a:documentation>
          <name ns="">deprecated</name>
          <choice>
            <value>0</value>
            <value>1</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute>
          <a:documentation>Version number from which this element is deprecated</a:documentation>
          <name ns="">deprecated-version</name>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute>
          <a:documentation>version number of an element</a:documentation>
          <name ns="">version</name>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute>
          <a:documentation>give the statibility status of the element. Can take the values &quot;Stable&quot;, &quot;Unstable&quot; or &quot;Private&quot;</a:documentation>
          <name ns="">stability</name>
          <data type="string"/>
        </attribute>
      </optional>
    </group>
  </define>
  <define name="DocElements">
    <interleave>
      <optional>
        <element>
          <a:documentation>Version of the documentation</a:documentation>
          <name ns="http://www.gtk.org/introspection/core/1.0">doc-version</name>
          <optional>
            <attribute>
              <a:documentation>Preserve the original formatting of the documentation from the source code</a:documentation>
              <name ns="http://www.w3.org/XML/1998/namespace">space</name>
              <value>preserve</value>
            </attribute>
          </optional>
          <optional>
            <attribute>
              <a:documentation>Preserve the original formatting of the documentation from the source code. Recommended to use this instead of xml:space</a:documentation>
              <name ns="http://www.w3.org/XML/1998/namespace">whitespace</name>
              <value>preserve</value>
            </attribute>
          </optional>
          <text/>
        </element>
      </optional>
      <optional>
        <element>
          <a:documentation>give the stability of the documentation</a:documentation>
          <name ns="http://www.gtk.org/introspection/core/1.0">doc-stability</name>
          <optional>
            <attribute>
              <a:documentation>Preserve the original formatting of the documentation from the source code</a:documentation>
              <name ns="http://www.w3.org/XML/1998/namespace">space</name>
              <value>preserve</value>
            </attribute>
          </optional>
          <optional>
            <attribute>
              <a:documentation>Preserve the original formatting of the documentation from the source code. Recommended to use this instead of xml:space</a:documentation>
              <name ns="http://www.w3.org/XML/1998/namespace">whitespace</name>
              <value>preserve</value>
            </attribute>
          </optional>
          <text/>
        </element>
      </optional>
      <optional>
        <element>
          <a:documentation>documentation of an element</a:documentation>
          <name ns="http://www.gtk.org/introspection/core/1.0">doc</name>
          <optional>
            <attribute>
              <a:documentation>Preserve the original formatting of the documentation from the source code</a:documentation>
              <name ns="http://www.w3.org/XML/1998/namespace">space</name>
              <value>preserve</value>
            </attribute>
          </optional>
          <optional>
            <attribute>
              <a:documentation>Keep the whitespace as they were in the source code</a:documentation>
              <name ns="http://www.w3.org/XML/1998/namespace">whitespace</name>
              <value>preserve</value>
            </attribute>
          </optional>
          <attribute>
            <a:documentation>The file containing this documentation</a:documentation>
            <name ns="">filename</name>
            <data type="string"/>
          </attribute>
          <attribute>
            <a:documentation>The first line of the documentation in the source code</a:documentation>
            <name ns="">line</name>
            <data type="string"/>
          </attribute>
          <optional>
            <attribute>
              <a:documentation>The first column of the documentation in the source code</a:documentation>
              <name ns="">column</name>
              <data type="string"/>
            </attribute>
          </optional>
          <text/>
        </element>
      </optional>
      <optional>
        <element>
          <a:documentation>Deprecated documentation of an element. Kept for historical reasons in general</a:documentation>
          <name ns="http://www.gtk.org/introspection/core/1.0">doc-deprecated</name>
          <optional>
            <attribute>
              <a:documentation>Preserve the original formatting of the documentation from the source code</a:documentation>
              <name ns="http://www.w3.org/XML/1998/namespace">space</name>
              <value>preserve</value>
            </attribute>
          </optional>
          <optional>
            <attribute>
              <a:documentation>Keep the whitespace as they were in the source code</a:documentation>
              <name ns="http://www.w3.org/XML/1998/namespace">whitespace</name>
              <value>preserve</value>
            </attribute>
          </optional>
          <text/>
        </element>
      </optional>
      <optional>
        <element>
          <a:documentation>Position of the documentation in the original source code</a:documentation>
          <name ns="http://www.gtk.org/introspection/core/1.0">source-position</name>
          <attribute>
            <a:documentation>File name of the source of the documentation</a:documentation>
            <name ns="">filename</name>
            <data type="string"/>
          </attribute>
          <attribute>
            <a:documentation>The first line of the documentation in the source code</a:documentation>
            <name ns="">line</name>
            <data type="string"/>
          </attribute>
          <optional>
            <attribute>
              <a:documentation>The first column of the documentation in the source code</a:documentation>
              <name ns="">column</name>
              <data type="string"/>
            </attribute>
          </optional>
        </element>
      </optional>
    </interleave>
  </define>
  <define name="Info.elements">
    <interleave>
      <ref name="DocElements"/>
      <zeroOrMore>
        <ref name="Annotation"/>
      </zeroOrMore>
    </interleave>
  </define>
  <define name="Constant">
    <element>
      <name ns="http://www.gtk.org/introspection/core/1.0">constant</name>
      <ref name="Info.attrs"/>
      <attribute>
        <a:documentation>name of the constant</a:documentation>
        <name ns="">name</name>
        <data type="string"/>
      </attribute>
      <attribute>
        <a:documentation>value of the constant</a:documentation>
        <name ns="">value</name>
        <data type="string"/>
      </attribute>
      <optional>
        <attribute>
          <a:documentation>corresponding C type of the constant in C</a:documentation>
          <name ns="http://www.gtk.org/introspection/c/1.0">type</name>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute>
          <a:documentation>corresponding C identifier in the source code</a:documentation>
          <name ns="http://www.gtk.org/introspection/c/1.0">identifier</name>
          <data type="string"/>
        </attribute>
      </optional>
      <interleave>
        <ref name="Info.elements"/>
        <optional>
          <ref name="AnyType"/>
        </optional>
      </interleave>
    </element>
  </define>
  <define name="Property">
    <element>
      <name ns="http://www.gtk.org/introspection/core/1.0">property</name>
      <ref name="Info.attrs"/>
      <attribute>
        <a:documentation>name of the property</a:documentation>
        <name ns="">name</name>
        <data type="string"/>
      </attribute>
      <optional>
        <attribute>
          <a:documentation>Binary attribute, true if the property is writeable, that is it has a setter function</a:documentation>
          <name ns="">writable</name>
          <choice>
            <value>0</value>
            <value>1</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute>
          <a:documentation>Binary attribute, true if the property is readable, that is it has a getter function</a:documentation>
          <name ns="">readable</name>
          <choice>
            <value>0</value>
            <value>1</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute>
          <a:documentation>Binary attribute, true if the property will be set upon construction</a:documentation>
          <name ns="">construct</name>
          <choice>
            <value>0</value>
            <value>1</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute>
          <a:documentation>Binary attribute, true if the property can only be set upon construction</a:documentation>
          <name ns="">construct-only</name>
          <choice>
            <value>0</value>
            <value>1</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute>
          <a:documentation>The setter function for this property</a:documentation>
          <name ns="">setter</name>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute>
          <a:documentation>The getter function for this property</a:documentation>
          <name ns="">getter</name>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute>
          <a:documentation>The default value of the property, as a string; if missing, the default value is zero for integer types, and null for pointer types</a:documentation>
          <name ns="">default-value</name>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <ref name="TransferOwnership"/>
      </optional>
      <interleave>
        <ref name="Info.elements"/>
        <ref name="AnyType"/>
      </interleave>
    </element>
  </define>
  <define name="Signal">
    <element>
      <name ns="http://www.gtk.org/introspection/glib/1.0">signal</name>
      <ref name="Info.attrs"/>
      <attribute>
        <a:documentation>name of the signal</a:documentation>
        <name ns="">name</name>
        <data type="string"/>
      </attribute>
      <optional>
        <attribute>
          <a:documentation>Binary attribute, true if the signal has a detailed parameter (https://docs.gtk.org/gobject/concepts.html#the-detail-argument and https://docs.gtk.org/gobject/flags.SignalFlags.html)</a:documentation>
          <name ns="">detailed</name>
          <choice>
            <value>0</value>
            <value>1</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute>
          <a:documentation>When to run the signal during the 5 steps of signal emission (https://docs.gtk.org/gobject/concepts.html#signal-emission and https://docs.gtk.org/gobject/flags.SignalFlags.html)</a:documentation>
          <name ns="">when</name>
          <choice>
            <value>first</value>
            <value>last</value>
            <value>cleanup</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute>
          <a:documentation>Binary attribute, true if the signal can be freely emitted on alive objects from user code (https://docs.gtk.org/gobject/flags.SignalFlags.html)</a:documentation>
          <name ns="">action</name>
          <choice>
            <value>0</value>
            <value>1</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute>
          <a:documentation>Binary attribute, true if no emission hooks are supported for this signal (https://docs.gtk.org/gobject/flags.SignalFlags.html) </a:documentation>
          <name ns="">no-hooks</name>
          <choice>
            <value>0</value>
            <value>1</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute>
          <a:documentation>Binary attribute, true if signals emitted for an object while currently being in emission for this very object will not be emitted recursively, but instead cause the first emission to be restarted (https://docs.gtk.org/gobject/flags.SignalFlags.html)</a:documentation>
          <name ns="">no-recurse</name>
          <choice>
            <value>0</value>
            <value>1</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute>
          <a:documentation>The emitter method for the signal</a:documentation>
          <name ns="">emitter</name>
          <data type="string"/>
        </attribute>
      </optional>
      <interleave>
        <ref name="Info.elements"/>
        <optional>
          <ref name="Callable.params"/>
        </optional>
        <optional>
          <ref name="Callable.return"/>
        </optional>
      </interleave>
    </element>
  </define>
  <define name="Field">
    <element>
      <name ns="http://www.gtk.org/introspection/core/1.0">field</name>
      <ref name="Info.attrs"/>
      <attribute>
        <a:documentation>name of the field</a:documentation>
        <name ns="">name</name>
        <data type="string"/>
      </attribute>
      <optional>
        <attribute>
          <a:documentation>Binary attribute, true if the field is writeable</a:documentation>
          <name ns="">writable</name>
          <choice>
            <value>0</value>
            <value>1</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute>
          <a:documentation>Binary attribute, true if the field is readable</a:documentation>
          <name ns="">readable</name>
          <choice>
            <value>0</value>
            <value>1</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute>
          <a:documentation>Binary attribute, true if the field is private to the structure or has public (&quot;0&quot;) visibility</a:documentation>
          <name ns="">private</name>
          <choice>
            <value>0</value>
            <value>1</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute>
          <a:documentation>number of bits of the field</a:documentation>
          <name ns="">bits</name>
          <data type="integer"/>
        </attribute>
      </optional>
      <interleave>
        <ref name="Info.elements"/>
        <choice>
          <ref name="Callback"/>
          <ref name="AnyType"/>
        </choice>
      </interleave>
    </element>
  </define>
  <define name="Callback">
    <element>
      <name ns="http://www.gtk.org/introspection/core/1.0">callback</name>
      <ref name="Info.attrs"/>
      <attribute>
        <a:documentation>name of the callback</a:documentation>
        <name ns="">name</name>
        <data type="string"/>
      </attribute>
      <optional>
        <attribute>
          <a:documentation>the C type returned by the callback closure (i.e. function)</a:documentation>
          <name ns="http://www.gtk.org/introspection/c/1.0">type</name>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute>
          <a:documentation>Binary attribute, true if the callback can throw an error</a:documentation>
          <name ns="">throws</name>
          <choice>
            <value>0</value>
            <value>1</value>
          </choice>
        </attribute>
      </optional>
      <interleave>
        <ref name="Info.elements"/>
        <optional>
          <ref name="Callable.params"/>
        </optional>
        <optional>
          <ref name="Callable.return"/>
        </optional>
      </interleave>
    </element>
  </define>
  <define name="Implements">
    <element>
      <name ns="http://www.gtk.org/introspection/core/1.0">implements</name>
      <attribute>
        <a:documentation>name of the interface implemented by a class</a:documentation>
        <name ns="">name</name>
        <data type="string"/>
      </attribute>
    </element>
  </define>
  <define name="Prerequisite">
    <element>
      <name ns="http://www.gtk.org/introspection/core/1.0">prerequisite</name>
      <attribute>
        <a:documentation>name of the required interface</a:documentation>
        <name ns="">name</name>
        <data type="string"/>
      </attribute>
    </element>
  </define>
  <define name="AnyType">
    <choice>
      <ref name="Type"/>
      <ref name="ArrayType"/>
    </choice>
  </define>
  <define name="Type">
    <element>
      <name ns="http://www.gtk.org/introspection/core/1.0">type</name>
      <optional>
        <attribute>
          <a:documentation>name of the type</a:documentation>
          <name ns="">name</name>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute>
          <a:documentation>the C representation of the type</a:documentation>
          <name ns="http://www.gtk.org/introspection/c/1.0">type</name>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute>
          <a:documentation>Binary attribute which is &quot;0&quot; (false) if the element is not introspectable. It doesn&#x27;t exist in the bindings, due in general to missing information in the annotations in the original C code</a:documentation>
          <name ns="">introspectable</name>
          <choice>
            <value>0</value>
            <value>1</value>
          </choice>
        </attribute>
      </optional>
      <interleave>
        <ref name="DocElements"/>
        <zeroOrMore>
          <ref name="AnyType"/>
        </zeroOrMore>
      </interleave>
    </element>
  </define>
  <define name="ArrayType">
    <element>
      <name ns="http://www.gtk.org/introspection/core/1.0">array</name>
      <optional>
        <attribute>
          <a:documentation>name of the array type</a:documentation>
          <name ns="">name</name>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute>
          <a:documentation>Binary attribute, true if the last element of the array is zero. For example, in an array of pointers, the last pointer would be NULL</a:documentation>
          <name ns="">zero-terminated</name>
          <choice>
            <value>0</value>
            <value>1</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute>
          <a:documentation>size of an array of predetermined fixed size. For example a C array declared as char arr[5].</a:documentation>
          <name ns="">fixed-size</name>
          <data type="integer"/>
        </attribute>
      </optional>
      <optional>
        <attribute>
          <a:documentation>Binary attribute which is &quot;0&quot; (false) if the element is not introspectable. It doesn&#x27;t exist in the bindings, due in general to missing information in the annotations in the original C code</a:documentation>
          <name ns="">introspectable</name>
          <choice>
            <value>0</value>
            <value>1</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute>
          <a:documentation>0-based index of parameter element that specifies the length of the array</a:documentation>
          <name ns="">length</name>
          <data type="integer"/>
        </attribute>
      </optional>
      <optional>
        <attribute>
          <a:documentation>the C representation of the array type</a:documentation>
          <name ns="http://www.gtk.org/introspection/c/1.0">type</name>
          <data type="string"/>
        </attribute>
      </optional>
      <ref name="AnyType"/>
    </element>
  </define>
  <define name="TransferOwnership">
    <attribute>
      <name ns="">transfer-ownership</name>
      <choice>
        <value>none</value>
        <value>container</value>
        <value>full</value>
      </choice>
    </attribute>
  </define>
  <define name="Constructor">
    <element>
      <name ns="http://www.gtk.org/introspection/core/1.0">constructor</name>
      <ref name="Callable.attrs"/>
      <interleave>
        <ref name="Info.elements"/>
        <optional>
          <ref name="Callable.params"/>
        </optional>
        <optional>
          <ref name="Callable.return"/>
        </optional>
      </interleave>
    </element>
  </define>
  <define name="Callable.attrs">
    <group>
      <ref name="Info.attrs"/>
      <attribute>
        <a:documentation>name of the Callable</a:documentation>
        <name ns="">name</name>
        <data type="string"/>
      </attribute>
      <optional>
        <attribute>
          <name ns="http://www.gtk.org/introspection/c/1.0">identifier</name>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute>
          <a:documentation>Callable it is shadowed by. For example, in C++, only one version of an overloaded callable will appear</a:documentation>
          <name ns="">shadowed-by</name>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute>
          <a:documentation>Callable it shadows. For example, in C++, only one version of an overloaded callable will appear</a:documentation>
          <name ns="">shadows</name>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute>
          <a:documentation>Binary attribute, true if the callable can throw an error</a:documentation>
          <name ns="">throws</name>
          <choice>
            <value>0</value>
            <value>1</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute>
          <a:documentation>if for backward compatibility reason the callable has a name in the source code but should be known by another one, this attribute contains the new name</a:documentation>
          <name ns="">moved-to</name>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute>
          <a:documentation>The name of the asynchronous version of this callable</a:documentation>
          <name ns="http://www.gtk.org/introspection/glib/1.0">async-func</name>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute>
          <a:documentation>The name of the synchronous version of this callable</a:documentation>
          <name ns="http://www.gtk.org/introspection/glib/1.0">sync-func</name>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute>
          <a:documentation>The name of the callable which finishes the asynchronuos operation of this function</a:documentation>
          <name ns="http://www.gtk.org/introspection/glib/1.0">finish-func</name>
          <data type="string"/>
        </attribute>
      </optional>
    </group>
  </define>
  <define name="VarArgs">
    <element>
      <name ns="http://www.gtk.org/introspection/core/1.0">varargs</name>
      <empty/>
    </element>
  </define>
  <define name="Callable.params">
    <element>
      <a:documentation>parameters element of a callable, that is in general parameters of a function or similar</a:documentation>
      <name ns="http://www.gtk.org/introspection/core/1.0">parameters</name>
      <interleave>
        <zeroOrMore>
          <element>
            <a:documentation>parameter element of a list of parameters</a:documentation>
            <name ns="http://www.gtk.org/introspection/core/1.0">parameter</name>
            <optional>
              <attribute>
                <a:documentation>name of the parameter</a:documentation>
                <name ns="">name</name>
                <data type="string"/>
              </attribute>
            </optional>
            <optional>
              <attribute>
                <a:documentation>Binary attribute, true if the parameter can have a null value</a:documentation>
                <name ns="">nullable</name>
                <choice>
                  <value>0</value>
                  <value>1</value>
                </choice>
              </attribute>
            </optional>
            <optional>
              <attribute>
                <a:documentation>Deprecated. Replaced by nullable and optional</a:documentation>
                <name ns="">allow-none</name>
                <choice>
                  <value>0</value>
                  <value>1</value>
                </choice>
              </attribute>
            </optional>
            <optional>
              <attribute>
                <a:documentation>Binary attribute which is &quot;0&quot; (false) if the element is not introspectable. It doesn&#x27;t exist in the bindings, due in general to missing information in the annotations in the original C code</a:documentation>
                <name ns="">introspectable</name>
                <choice>
                  <value>0</value>
                  <value>1</value>
                </choice>
              </attribute>
            </optional>
            <optional>
              <attribute>
                <a:documentation>the parameter is a user_data for callbacks. The value points to a different parameter that is the actual callback</a:documentation>
                <name ns="">closure</name>
                <data type="integer"/>
              </attribute>
            </optional>
            <optional>
              <attribute>
                <a:documentation>the parameter is a destroy_data for callbacks. The value points to a different parameter that is the actual callback</a:documentation>
                <name ns="">destroy</name>
                <data type="integer"/>
              </attribute>
            </optional>
            <optional>
              <attribute>
                <a:documentation>the parameter is a callback, the value indicates the lifetime of the call. For language bindings which want to know when the resources required to do the call can be freed. &quot;notified&quot; valid until a GDestroyNotify argument is called, &quot;async&quot; only valid for the duration of the first callback invocation (can only be called once), &quot;call&quot; only valid for the duration of the call, can be called multiple times during the call, &quot;forever&quot; valid until the process terminates.</a:documentation>
                <name ns="">scope</name>
                <choice>
                  <value>notified</value>
                  <value>async</value>
                  <value>call</value>
                  <value>forever</value>
                </choice>
              </attribute>
            </optional>
            <optional>
              <attribute>
                <a:documentation>direction of the parameter. &quot;in&quot; goes into the callable, &quot;out&quot; for output parameters from the callable (reference in C++, var in Pascal, etc...), &quot;inout&quot; for both (like a pre-allocated structure which will be filled-in by the callable)</a:documentation>
                <name ns="">direction</name>
                <choice>
                  <value>out</value>
                  <value>in</value>
                  <value>inout</value>
                </choice>
              </attribute>
            </optional>
            <optional>
              <attribute>
                <a:documentation>Binary attribute, true if the caller should allocate the parameter before calling the callable</a:documentation>
                <name ns="">caller-allocates</name>
                <choice>
                  <value>0</value>
                  <value>1</value>
                </choice>
              </attribute>
            </optional>
            <optional>
              <attribute>
                <a:documentation>Binary attribute, true if the parameter is optional</a:documentation>
                <name ns="">optional</name>
                <choice>
                  <value>0</value>
                  <value>1</value>
                </choice>
              </attribute>
            </optional>
            <optional>
              <attribute>
                <a:documentation> Binary attribute, true if the parameter can be omitted from the introspected output</a:documentation>
                <name ns="">skip</name>
                <choice>
                  <value>0</value>
                  <value>1</value>
                </choice>
              </attribute>
            </optional>
            <optional>
              <ref name="TransferOwnership"/>
            </optional>
            <interleave>
              <ref name="DocElements"/>
              <optional>
                <choice>
                  <ref name="AnyType"/>
                  <ref name="VarArgs"/>
                </choice>
              </optional>
              <zeroOrMore>
                <ref name="Annotation"/>
              </zeroOrMore>
            </interleave>
          </element>
        </zeroOrMore>
        <optional>
          <element>
            <a:documentation>instance-parameter is a parameter of a C function which is an instance of an existing object. So the callable is surely a method of a class, and this parameter points to the instance of the object. In C++, this would be equivalent to the pointer this which is not passed to the method, in Python it&#x27;s equivalent to self.</a:documentation>
            <name ns="http://www.gtk.org/introspection/core/1.0">instance-parameter</name>
            <attribute>
              <a:documentation>name of the instance-parameter</a:documentation>
              <name ns="">name</name>
              <data type="string"/>
            </attribute>
            <optional>
              <attribute>
                <a:documentation>Binary attribute, true if the parameter can have a null value</a:documentation>
                <name ns="">nullable</name>
                <choice>
                  <value>0</value>
                  <value>1</value>
                </choice>
              </attribute>
            </optional>
            <optional>
              <attribute>
                <a:documentation>Deprecated. Replaced by nullable and optional</a:documentation>
                <name ns="">allow-none</name>
                <choice>
                  <value>0</value>
                  <value>1</value>
                </choice>
              </attribute>
            </optional>
            <optional>
              <attribute>
                <a:documentation>direction of the parameter. &quot;in&quot; goes into the callable, &quot;out&quot; for output parameters from the callable (reference in C++, var in Pascal, etc...), &quot;inout&quot; for both (like a pre-allocated structure which will be filled-in by the callable)</a:documentation>
                <name ns="">direction</name>
                <choice>
                  <value>out</value>
                  <value>in</value>
                  <value>inout</value>
                </choice>
              </attribute>
            </optional>
            <optional>
              <attribute>
                <a:documentation>Binary attribute, true if the caller should allocate the parameter before calling the callable</a:documentation>
                <name ns="">caller-allocates</name>
                <choice>
                  <value>0</value>
                  <value>1</value>
                </choice>
              </attribute>
            </optional>
            <optional>
              <ref name="TransferOwnership"/>
            </optional>
            <interleave>
              <ref name="DocElements"/>
              <ref name="Type"/>
            </interleave>
          </element>
        </optional>
      </interleave>
    </element>
  </define>
  <define name="Callable.return">
    <element>
      <name ns="http://www.gtk.org/introspection/core/1.0">return-value</name>
      <optional>
        <attribute>
          <a:documentation>Binary attribute which is &quot;0&quot; (false) if the element is not introspectable. It doesn&#x27;t exist in the bindings, due in general to missing information in the annotations in the original C code</a:documentation>
          <name ns="">introspectable</name>
          <choice>
            <value>0</value>
            <value>1</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute>
          <a:documentation>Binary attribute, true if the parameter can have a null value</a:documentation>
          <name ns="">nullable</name>
          <choice>
            <value>0</value>
            <value>1</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute>
          <a:documentation>the parameter is a user_data for callbacks. The value points to a different parameter that is the actual callback</a:documentation>
          <name ns="">closure</name>
          <data type="integer"/>
        </attribute>
      </optional>
      <optional>
        <attribute>
          <a:documentation>the parameter is a callback, the value indicates the lifetime of the call. For language bindings which want to know when the resources required to do the call can be freed. &quot;notified&quot; valid until a GDestroyNotify argument is called, &quot;async&quot; only valid for the duration of the first callback invocation (can only be called once), &quot;call&quot; only valid for the duration of the call, can be called multiple times during the call, &quot;forever&quot; valid until the process terminates.</a:documentation>
          <name ns="">scope</name>
          <choice>
            <value>notified</value>
            <value>async</value>
            <value>call</value>
            <value>forever</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute>
          <a:documentation>the parameter is a destroy_data for callbacks. The value points to a different parameter that is the actual callback</a:documentation>
          <name ns="">destroy</name>
          <data type="integer"/>
        </attribute>
      </optional>
      <optional>
        <attribute>
          <a:documentation> Binary attribute, true if the parameter can be omitted from the introspected output</a:documentation>
          <name ns="">skip</name>
          <choice>
            <value>0</value>
            <value>1</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute>
          <a:documentation>Deprecated. Replaced by nullable and optional</a:documentation>
          <name ns="">allow-none</name>
          <choice>
            <value>0</value>
            <value>1</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <ref name="TransferOwnership"/>
      </optional>
      <interleave>
        <ref name="DocElements"/>
        <zeroOrMore>
          <ref name="Annotation"/>
        </zeroOrMore>
        <ref name="AnyType"/>
      </interleave>
    </element>
  </define>
  <define name="Function">
    <element>
      <name ns="http://www.gtk.org/introspection/core/1.0">function</name>
      <ref name="Callable.attrs"/>
      <interleave>
        <ref name="Info.elements"/>
        <optional>
          <ref name="Callable.params"/>
        </optional>
        <optional>
          <ref name="Callable.return"/>
        </optional>
      </interleave>
    </element>
  </define>
  <define name="FunctionInline">
    <element>
      <a:documentation>element defining an inline function</a:documentation>
      <name ns="http://www.gtk.org/introspection/core/1.0">function-inline</name>
      <ref name="Callable.attrs"/>
      <interleave>
        <optional>
          <ref name="Callable.params"/>
        </optional>
        <optional>
          <ref name="Callable.return"/>
        </optional>
        <ref name="DocElements"/>
      </interleave>
    </element>
  </define>
  <define name="FunctionMacro">
    <element>
      <name ns="http://www.gtk.org/introspection/core/1.0">function-macro</name>
      <ref name="Callable.attrs"/>
      <interleave>
        <ref name="Info.elements"/>
        <optional>
          <ref name="Callable.params"/>
        </optional>
      </interleave>
    </element>
  </define>
  <define name="Method">
    <element>
      <name ns="http://www.gtk.org/introspection/core/1.0">method</name>
      <ref name="Callable.attrs"/>
      <optional>
        <attribute>
          <a:documentation>The GObject property that is set by this method</a:documentation>
          <name ns="http://www.gtk.org/introspection/glib/1.0">set-property</name>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute>
          <a:documentation>The GObject property that is retrieved by this method</a:documentation>
          <name ns="http://www.gtk.org/introspection/glib/1.0">get-property</name>
          <data type="string"/>
        </attribute>
      </optional>
      <interleave>
        <ref name="Info.elements"/>
        <optional>
          <ref name="Callable.params"/>
        </optional>
        <optional>
          <ref name="Callable.return"/>
        </optional>
      </interleave>
    </element>
  </define>
  <define name="MethodInline">
    <element>
      <a:documentation>element defining an inline method from a type</a:documentation>
      <name ns="http://www.gtk.org/introspection/core/1.0">method-inline</name>
      <ref name="Callable.attrs"/>
      <interleave>
        <ref name="Info.elements"/>
        <optional>
          <ref name="Callable.params"/>
        </optional>
        <optional>
          <ref name="Callable.return"/>
        </optional>
      </interleave>
    </element>
  </define>
  <define name="VirtualMethod">
    <element>
      <name ns="http://www.gtk.org/introspection/core/1.0">virtual-method</name>
      <ref name="Callable.attrs"/>
      <optional>
        <attribute>
          <a:documentation>name of the callable called when invoking this virtual method</a:documentation>
          <name ns="">invoker</name>
          <data type="string"/>
        </attribute>
      </optional>
      <interleave>
        <ref name="Info.elements"/>
        <optional>
          <ref name="Callable.params"/>
        </optional>
        <optional>
          <ref name="Callable.return"/>
        </optional>
      </interleave>
    </element>
  </define>
  <define name="Union">
    <element>
      <name ns="http://www.gtk.org/introspection/core/1.0">union</name>
      <ref name="Info.attrs"/>
      <optional>
        <attribute>
          <a:documentation>name of the union</a:documentation>
          <name ns="">name</name>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute>
          <a:documentation>C type defining the union</a:documentation>
          <name ns="http://www.gtk.org/introspection/c/1.0">type</name>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute>
          <a:documentation>prefix to filter out from C functions. For example, gtk_window_new will lose gtk_</a:documentation>
          <name ns="http://www.gtk.org/introspection/c/1.0">symbol-prefix</name>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute>
          <a:documentation>GObject compatible type name</a:documentation>
          <name ns="http://www.gtk.org/introspection/glib/1.0">type-name</name>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute>
          <a:documentation>function to retrieve the GObject compatible type of the element</a:documentation>
          <name ns="http://www.gtk.org/introspection/glib/1.0">get-type</name>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute>
          <a:documentation>Name of the function used to copy the union</a:documentation>
          <name ns="">copy-function</name>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute>
          <a:documentation>Name of the function used to free the union</a:documentation>
          <name ns="">free-function</name>
          <data type="string"/>
        </attribute>
      </optional>
      <interleave>
        <ref name="Info.elements"/>
        <zeroOrMore>
          <ref name="Field"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="Constructor"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="Method"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="MethodInline"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="Function"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="FunctionInline"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="Record"/>
        </zeroOrMore>
      </interleave>
    </element>
  </define>
  <define name="BitField">
    <element>
      <name ns="http://www.gtk.org/introspection/core/1.0">bitfield</name>
      <ref name="Info.attrs"/>
      <attribute>
        <a:documentation>name of the bit field</a:documentation>
        <name ns="">name</name>
        <data type="string"/>
      </attribute>
      <attribute>
        <a:documentation>corresponding C type of the bit field type</a:documentation>
        <name ns="http://www.gtk.org/introspection/c/1.0">type</name>
        <data type="string"/>
      </attribute>
      <optional>
        <attribute>
          <a:documentation>GObject compatible type name</a:documentation>
          <name ns="http://www.gtk.org/introspection/glib/1.0">type-name</name>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute>
          <a:documentation>function to retrieve the GObject compatible type of the element</a:documentation>
          <name ns="http://www.gtk.org/introspection/glib/1.0">get-type</name>
          <data type="string"/>
        </attribute>
      </optional>
      <interleave>
        <ref name="Info.elements"/>
        <zeroOrMore>
          <ref name="Member"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="Function"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="FunctionInline"/>
        </zeroOrMore>
      </interleave>
    </element>
  </define>
  <define name="Enum">
    <element>
      <name ns="http://www.gtk.org/introspection/core/1.0">enumeration</name>
      <ref name="Info.attrs"/>
      <attribute>
        <a:documentation>name of the enumeration</a:documentation>
        <name ns="">name</name>
        <data type="string"/>
      </attribute>
      <attribute>
        <a:documentation>corresponding C type of the enumeration type</a:documentation>
        <name ns="http://www.gtk.org/introspection/c/1.0">type</name>
        <data type="string"/>
      </attribute>
      <optional>
        <attribute>
          <a:documentation>GObject compatible type name</a:documentation>
          <name ns="http://www.gtk.org/introspection/glib/1.0">type-name</name>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute>
          <a:documentation>function to retrieve the GObject compatible type of the element</a:documentation>
          <name ns="http://www.gtk.org/introspection/glib/1.0">get-type</name>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute>
          <a:documentation>Error domain of this enumeration in a stringified form</a:documentation>
          <name ns="http://www.gtk.org/introspection/glib/1.0">error-domain</name>
          <data type="string"/>
        </attribute>
      </optional>
      <interleave>
        <ref name="Info.elements"/>
        <zeroOrMore>
          <ref name="Member"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="Function"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="FunctionInline"/>
        </zeroOrMore>
      </interleave>
    </element>
  </define>
  <define name="Member">
    <element>
      <name ns="http://www.gtk.org/introspection/core/1.0">member</name>
      <ref name="Info.attrs"/>
      <attribute>
        <a:documentation>name of the member</a:documentation>
        <name ns="">name</name>
        <data type="string"/>
      </attribute>
      <attribute>
        <a:documentation>value of the member</a:documentation>
        <name ns="">value</name>
        <data type="string"/>
      </attribute>
      <attribute>
        <a:documentation>corresponding C type of the member</a:documentation>
        <name ns="http://www.gtk.org/introspection/c/1.0">identifier</name>
        <data type="string"/>
      </attribute>
      <optional>
        <attribute>
          <a:documentation>short nickname of the member (from GEnumValue/GFlagsValue)</a:documentation>
          <name ns="http://www.gtk.org/introspection/glib/1.0">nick</name>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute>
          <a:documentation>name of the member (from GEnumValue/GFlagsValue)</a:documentation>
          <name ns="http://www.gtk.org/introspection/glib/1.0">name</name>
          <data type="string"/>
        </attribute>
      </optional>
      <ref name="Info.elements"/>
    </element>
  </define>
  <define name="DocSection">
    <element>
      <name ns="http://www.gtk.org/introspection/core/1.0">docsection</name>
      <attribute>
        <name ns="">name</name>
        <data type="string"/>
      </attribute>
      <ref name="DocElements"/>
    </element>
  </define>
</grammar>
